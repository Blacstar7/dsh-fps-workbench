{
  "name": "@local/claude-code-workbench",
  "version": "0.1.75",
  "description": "Session outputs, tool progress summaries, attachment drafts, provider usage, and image fallback for DeepSeek Harness.",
  "author": "Blacstar7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blacstar7/dsh-fps-workbench.git"
  },
  "homepage": "https://github.com/Blacstar7/dsh-fps-workbench#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "workbench"],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "provider-usage.js",
    "session-outputs.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "locale/detail.*.md",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
